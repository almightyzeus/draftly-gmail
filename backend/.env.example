# ============================================================================
# DRAFTLY - Gmail AI Reply Agent
# Environment Configuration Example
# ============================================================================

# SERVER CONFIGURATION
PORT=3000
NODE_ENV=development

# ============================================================================
# DATABASE
# ============================================================================
# MongoDB connection string
# Local: mongodb://localhost:27017/draftly
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/draftly
# Docker: mongodb://mongodb:27017/draftly
MONGODB_URI=mongodb://localhost:27017/draftly

# ============================================================================
# JWT AUTHENTICATION
# ============================================================================
# Generate secrets with: openssl rand -base64 32
JWT_ACCESS_SECRET=your-secret-key-here-generate-with-openssl
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key-here-generate-with-openssl
JWT_REFRESH_EXPIRES_IN=7d

# ============================================================================
# DATA ENCRYPTION (AES-256-GCM)
# ============================================================================
# IMPORTANT: Must be exactly 32 bytes (256 bits) when base64-decoded
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY_BASE64=your-base64-encoded-32-byte-key-here

# ============================================================================
# OPENAI API
# ============================================================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# ============================================================================
# GOOGLE OAUTH2 (Gmail Integration)
# ============================================================================
# Create OAuth2 credentials at: https://console.cloud.google.com/
# Required scopes: https://www.googleapis.com/auth/gmail.modify
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# ============================================================================
# FRONTEND (CORS)
# ============================================================================
FRONTEND_URL=http://localhost:4200

