/* Type-checks the Vitest suites (tests/*.vitest.ts): npm run typecheck:tests. Vitest itself strips types without checking them. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["vitest/globals"]
  },
  "include": ["tests/**/*.ts", "vitest.setup.ts", "src/**/*.d.ts"]
}
