{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "typecheck:tests": "tsc -p tsconfig.spec.json"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.25",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
